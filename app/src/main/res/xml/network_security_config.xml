<?xml version="1.0" encoding="utf-8"?>
<!--
  The Qwen (DashScope) TTS service returns the generated audio file over a plain http:// OSS URL.
  Android blocks cleartext traffic by default (API 28+), which silently prevented the AI voice from
  ever downloading its audio. Allow cleartext only for the Alibaba OSS hosts that serve the audio.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">aliyuncs.com</domain>
    </domain-config>
</network-security-config>
