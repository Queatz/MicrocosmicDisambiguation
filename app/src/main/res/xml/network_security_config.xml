<?xml version="1.0" encoding="utf-8"?>
<!--
  Previously the Qwen (DashScope) TTS service returned generated audio over a plain http:// OSS
  URL, requiring a cleartext exception for Alibaba's OSS hosts. CosyVoice now streams the audio
  directly over the encrypted wss:// TTS connection (see QwenService.synthesizeSpeech), so no
  cleartext traffic is needed anymore; this config intentionally allows none.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false"/>
</network-security-config>
